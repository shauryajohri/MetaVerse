#!/bin/sh
# macOS / Linux entry point for `metaverse <command>`. The real logic is in scripts/metaverse.mjs.
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not installed. Download the LTS version from https://nodejs.org, then run: ./metaverse setup"
  exit 1
fi
exec node "$(dirname "$0")/scripts/metaverse.mjs" "$@"
